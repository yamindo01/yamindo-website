generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Yamindo CMS Models (Bilingual) ==========

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  subtitle      String
  en_subtitle   String   @default("")
  description   String
  en_description String  @default("")
  image         String
  bullets       String
  en_bullets    String   @default("[]")
  bgGradient    String   @default("from-teal-50 via-amber-50/30 to-orange-50")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  icon          String   @default("GraduationCap")
  color         String   @default("from-teal-400 to-teal-600")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cause {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  raised        String
  goal          String
  percent       Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Counter {
  id      String   @id @default(cuid())
  label   String
  en_label String  @default("")
  value   Int
  icon    String   @default("Users")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  role    String
  en_role String  @default("")
  bio     String
  en_bio  String  @default("")
  image   String
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id      String   @id @default(cuid())
  src     String
  alt     String
  en_alt  String  @default("")
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  role    String
  en_role String  @default("")
  text    String
  en_text String  @default("")
  image   String
  rating  Int      @default(5)
  tag     String
  en_tag  String  @default("")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  category      String
  en_category   String   @default("")
  date          String
  image         String
  excerpt       String
  en_excerpt    String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Partner {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  logo    String
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterEvent {
  id      String   @id @default(cuid())
  date    String
  title   String
  en_title String  @default("")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutInfo {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  badge         String
  en_badge      String   @default("")
  bullets       String
  en_bullets    String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DonationPreset {
  id      String   @id @default(cuid())
  label   String
  en_label String  @default("")
  amount  Int?
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
