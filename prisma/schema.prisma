generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Yamindo CMS Models (Bilingual) ==========

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  subtitle      String
  en_subtitle   String   @default("")
  description   String
  en_description String  @default("")
  image         String
  bullets       String
  en_bullets    String   @default("[]")
  bgGradient    String   @default("from-teal-50 via-amber-50/30 to-orange-50")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  icon          String   @default("GraduationCap")
  color         String   @default("from-teal-400 to-teal-600")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cause {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  raised        String
  goal          String
  percent       Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Counter {
  id      String   @id @default(cuid())
  label   String
  en_label String  @default("")
  value   Int
  icon    String   @default("Users")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  role    String
  en_role String  @default("")
  bio     String
  en_bio  String  @default("")
  image   String
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id      String   @id @default(cuid())
  src     String
  alt     String
  en_alt  String  @default("")
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  role    String
  en_role String  @default("")
  text    String
  en_text String  @default("")
  image   String
  rating  Int      @default(5)
  tag     String
  en_tag  String  @default("")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  category      String
  en_category   String   @default("")
  date          String
  image         String
  excerpt       String
  en_excerpt    String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Partner {
  id      String   @id @default(cuid())
  name    String
  en_name String  @default("")
  logo    String
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterEvent {
  id      String   @id @default(cuid())
  date    String
  title   String
  en_title String  @default("")
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutInfo {
  id            String   @id @default(cuid())
  title         String
  en_title      String   @default("")
  description   String
  en_description String  @default("")
  image         String
  badge         String
  en_badge      String   @default("")
  bullets       String
  en_bullets    String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DonationPreset {
  id      String   @id @default(cuid())
  label   String
  en_label String  @default("")
  amount  Int?
  order   Int      @default(0)
  active  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== Sub-Page Models (Bilingual) ==========

model AboutSection {
  id          String   @id @default(cuid())
  type        String
  title       String
  en_title    String   @default("")
  content     String
  en_content  String   @default("")
  image       String   @default("")
  items       String   @default("[]")
  en_items    String   @default("[]")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceDetail {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  en_title      String   @default("")
  short_desc    String
  en_short_desc String   @default("")
  content       String
  en_content    String   @default("")
  image         String
  icon          String   @default("Heart")
  features      String   @default("[]")
  en_features   String   @default("[]")
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProgramDetail {
  id              String   @id @default(cuid())
  title           String
  en_title        String   @default("")
  description     String
  en_description  String   @default("")
  image           String
  category        String
  en_category     String   @default("")
  raised          String   @default("Rp 0")
  goal            String   @default("Rp 0")
  percent         Int      @default(0)
  status          String   @default("active")
  order           Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryPageItem {
  id          String   @id @default(cuid())
  type        String   @default("photo")
  src         String
  thumbnail   String   @default("")
  alt         String
  en_alt      String   @default("")
  category    String   @default("")
  en_category String   @default("")
  video_url   String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  en_title        String   @default("")
  category        String
  en_category     String   @default("")
  content         String
  en_content      String   @default("")
  excerpt         String
  en_excerpt      String   @default("")
  image           String
  author          String   @default("")
  date            String
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgMember {
  id        String   @id @default(cuid())
  name      String
  en_name   String   @default("")
  position  String
  en_position String @default("")
  photo     String   @default("")
  level     Int      @default(3)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavMenu {
  id        String   @id @default(cuid())
  label     String
  en_label  String   @default("")
  href      String   @default("/")
  navKey    String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  children  NavMenuItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavMenuItem {
  id        String   @id @default(cuid())
  parentId  String
  label     String
  en_label  String   @default("")
  href      String   @default("/")
  icon      String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  parent    NavMenu @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EducationService {
  id          String   @id @default(cuid())
  title       String
  en_title    String   @default("")
  description String   @default("")
  en_description String @default("")
  image       String   @default("")
  icon        String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankAccount {
  id          String   @id @default(cuid())
  bankName    String
  en_bankName String   @default("")
  accountNo   String
  accountName String
  en_accountName String @default("")
  logo        String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
